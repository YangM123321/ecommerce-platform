# Copy to .env to override the defaults used by docker-compose.yml
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce

# JWT signing key: at least 32 characters. Use a long random value outside local dev.
JWT_SECRET=local-docker-secret-change-me-0123456789
# First admin account (created at startup if it doesn't exist)
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=Admin123!
