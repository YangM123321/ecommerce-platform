<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <!--
        Parent of all services. `mvn verify` here builds and tests every module.
        Build one service (plus what it needs):  mvn -pl order-service -am verify
    -->
    <groupId>com.miayang</groupId>
    <artifactId>ecommerce-platform</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ecommerce-platform</name>
    <description>E-commerce microservices: gateway, discovery, config, user, product and order services</description>

    <modules>
        <module>common</module>
        <module>config-server</module>
        <module>discovery-server</module>
        <module>api-gateway</module>
        <module>user-service</module>
        <module>product-service</module>
        <module>order-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!-- Spring Cloud release train that matches Spring Boot 3.4.x -->
        <spring-cloud.version>2024.0.1</spring-cloud.version>
        <!-- Docker Engine 29+ needs Testcontainers 1.21.4+ (older versions use a Docker API it rejects) -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- A version from the same time as Spring Boot 3.4, so its Netty matches Boot's -->
        <azure-storage-blob.version>12.29.0</azure-storage-blob.version>

        <!-- Session 6: test coverage (JaCoCo) and code analysis (SonarCloud) -->
        <jacoco.version>0.8.12</jacoco.version>
        <sonar-maven-plugin.version>5.0.0.4389</sonar-maven-plugin.version>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>yangm123321</sonar.organization>
        <!-- Each service is its own SonarCloud project; see scripts/sonar/create-projects.ps1 -->
        <sonar.projectKey>YangM123321_ecommerce-${project.artifactId}</sonar.projectKey>
        <sonar.projectName>ecommerce ${project.artifactId}</sonar.projectName>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.miayang</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- "mvn sonar:sonar" -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Measures which lines the tests run; writes target/site/jacoco/jacoco.xml, which SonarCloud reads. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
